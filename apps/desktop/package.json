{
  "name": "@flow/desktop",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Flow — system-wide voice dictation",
  "author": "Pawan Menuka",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "vitest run",
    "gen:icons": "node scripts/gen-icons.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@sentry/electron": "^7.15.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "koffi": "^2.10.0",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@flow/config": "workspace:*",
    "@flow/shared": "workspace:*",
    "@flow/ui": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.5.13",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
