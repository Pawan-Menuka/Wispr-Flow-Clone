# Flow API — copy to .env for local development
PORT=8787
DATABASE_URL=postgresql://flow:flow@localhost:5432/flow
REDIS_URL=redis://localhost:6379
# Auth is stubbed until Phase 10; anonymous WS connections allowed in dev.
REQUIRE_AUTH=false

# STT: leave unset for the echo stub. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Formatting LLM: leave unset for rule-based formatting only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
